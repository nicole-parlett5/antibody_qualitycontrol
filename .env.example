# RocketRide connection — auto-populated into .env by the RocketRide VS Code
# extension after you sign in (Settings > RocketRide > Host URL / API Key).
# Do not hand-edit the real values in .env; reconfigure via the extension instead.
ROCKETRIDE_URI=https://api.rocketride.ai
ROCKETRIDE_APIKEY=your-rocketride-api-key-here

# Linkup search API
LINKUP_API_KEY=your-linkup-api-key-here

# Same Linkup key, ROCKETRIDE_-prefixed so the RocketRide pipelines
# (pipelines/*.pipe) can substitute it via ${ROCKETRIDE_LINKUP_APIKEY}.
ROCKETRIDE_LINKUP_APIKEY=your-linkup-api-key-here

# Anthropic key for each pipeline's llm_anthropic node.
ROCKETRIDE_ANTHROPIC_KEY=your-anthropic-api-key-here
